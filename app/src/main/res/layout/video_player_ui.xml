<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_gravity="top"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <androidx.media3.ui.DefaultTimeBar
        android:id="@+id/time_progress"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="0dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        app:bar_height="10dp"
        android:background="@drawable/seekbar_background"
        android:clipToOutline="true"
        app:scrubber_drawable="@drawable/background_button_primary_round_1dp"
        app:scrubber_disabled_size="0dp"
        app:scrubber_enabled_size="16dp"
        app:scrubber_dragged_size="20dp"
        app:played_color="#44FFFFFF"
        app:buffered_color="#44222222"
        app:unplayed_color="#44222222"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView android:id="@id/exo_position"
        app:layout_constraintTop_toBottomOf="@id/time_progress"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="4dp"
        android:textColor="#999"
        android:fontFamily="@font/inter_light"
        android:textSize="11sp"
        style="@style/ExoStyledControls.TimeText.Position"/>

    <TextView android:id="@id/exo_duration"
        app:layout_constraintTop_toBottomOf="@id/time_progress"
        app:layout_constraintRight_toRightOf="@id/time_progress"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="#999"
        android:fontFamily="@font/inter_light"
        style="@style/ExoStyledControls.TimeText.Duration"/>

</androidx.constraintlayout.widget.ConstraintLayout>