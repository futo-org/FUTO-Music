<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:id="@+id/container_header"
        android:background="#000">


        <ImageView
            android:id="@+id/image_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="50dp"
            android:scaleType="centerCrop"
            />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/gradient_transparant_black"
            android:scaleType="fitXY"
            android:layout_marginTop="50dp"
            app:layout_constraintTop_toTopOf="@id/image_header"
            app:layout_constraintLeft_toLeftOf="@id/image_header"
            app:layout_constraintRight_toRightOf="@id/image_header"
            app:layout_constraintBottom_toBottomOf="@id/image_header"
            />


        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:src="@drawable/ic_chev_left"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/text_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/text_metadata"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/white"
            android:textSize="16dp"
            android:layout_marginLeft="15dp"
            android:layout_marginBottom="2dp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/text_metadata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/container_pills"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:textColor="#EEE"
            android:textSize="12dp"
            android:layout_marginLeft="15dp"
            android:layout_marginBottom="10dp"
            android:maxLines="1" />

        <LinearLayout
            android:id="@+id/container_pills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/view_search"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/button_play_all"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="5dp"
                android:background="@drawable/background_button_primary_round_5dp"
                android:gravity="center"
                android:layout_marginBottom="10dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_play"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_light"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:text="@string/play_all" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/button_shuffle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="15dp"
                android:background="@drawable/background_button_accent_round_5dp"
                android:gravity="center"
                android:layout_marginBottom="10dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_shuffle"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_light"
                    android:textColor="@color/white"
                    android:textSize="16dp"
                    android:text="@string/shuffle" />
            </LinearLayout>
        </LinearLayout>

        <com.futo.music.ui.views.general.SearchBarView
            android:id="@+id/view_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:paddingBottom="10dp"
            app:SearchBarView_hint="@string/hint_search_artist"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/container_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/container_header"
        android:orientation="vertical">



        <com.futo.music.ui.views.NoResultsView
            android:id="@+id/view_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/view_search" />

        <com.futo.music.ui.views.containers.ContentGrid
            android:id="@+id/grid_albums"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ContentGrid_text="Albums"
            app:ContentGrid_row_height="150dp"
            android:layout_marginTop="5dp"
            app:ContentGrid_vertical="false" />
    </LinearLayout>


    <com.futo.music.ui.views.containers.ContentGrid
        android:id="@+id/grid_songs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/container_main"
        app:layout_constraintBottom_toBottomOf="parent"
        app:ContentGrid_row_height="150dp"
        android:layout_marginTop="0dp"
        app:ContentGrid_vertical="true" />



</androidx.constraintlayout.widget.ConstraintLayout>