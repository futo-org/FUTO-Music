<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"

    android:layout_marginRight="5dp"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="5dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_thumbnail"
        android:layout_height="40dp"
        android:layout_width="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="10dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/roundedCorners_4dp"
        android:background="#555"
        android:alpha="0.7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <TextView
        android:id="@+id/text_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:fontFamily="@font/inter_regular"
        android:textAlignment="textStart"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginRight="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@id/image_thumbnail"
        app:layout_constraintRight_toLeftOf="@id/button_done"
        android:layout_marginLeft="15dp"
        android:textSize="13dp"
        android:text="Testing"
        android:layout_marginTop="7dp"
        />

    <TextView
        android:id="@+id/text_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="#75FFFFFF"
        android:fontFamily="@font/inter_regular"
        android:textAlignment="textStart"
        android:maxLines="1"
        android:text="Some Artist"
        app:layout_constraintTop_toBottomOf="@id/text_name"
        app:layout_constraintLeft_toLeftOf="@id/text_name"
        app:layout_constraintRight_toRightOf="@id/text_name" />

    <com.futo.music.ui.buttons.RatingsButton
        android:id="@+id/ratings"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:RatingsButton_swipe="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        app:layout_constraintTop_toBottomOf="@id/text_metadata"
        />

    <ImageButton
        android:id="@+id/button_done"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:src="@drawable/ic_label_off"
        android:background="@drawable/background_bar_round_4dp"
        android:scaleType="fitCenter"
        android:layout_marginRight="10dp"
        android:padding="10dp"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#88333333" />

    <ImageButton
        android:id="@+id/button_more"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/ic_dots"
        />

</androidx.constraintlayout.widget.ConstraintLayout>