<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:orientation="vertical">

            <com.futo.music.ui.views.general.SearchBarView
                android:id="@+id/view_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:paddingBottom="20dp"
                app:SearchBarView_hint="@string/hint_search_home"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <com.futo.music.ui.views.containers.ContentGrid
                android:id="@+id/grid_recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ContentGrid_text="Recent Plays"
                app:ContentGrid_row_height="150dp"
                android:layout_marginTop="20dp"
                app:ContentGrid_vertical="false" />
            <com.futo.music.ui.views.containers.ContentGrid
                android:id="@+id/grid_playlists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ContentGrid_row_height="150dp"
                app:ContentGrid_text="Your Playlists"
                android:layout_marginTop="20dp"
                app:ContentGrid_vertical="false" />
            <com.futo.music.ui.views.containers.ContentGrid
                android:id="@+id/grid_artists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ContentGrid_row_height="130dp"
                app:ContentGrid_text="Artists"
                android:layout_marginTop="20dp"
                app:ContentGrid_vertical="false" />
            <com.futo.music.ui.views.containers.ContentGrid
                android:id="@+id/grid_albums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ContentGrid_row_height="170dp"
                app:ContentGrid_text="Albums"
                android:layout_marginTop="20dp"
                app:ContentGrid_vertical="false" />
        </LinearLayout>

    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>