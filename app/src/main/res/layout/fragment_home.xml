<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:fadingEdgeLength="30dp"
        android:requiresFadingEdge="vertical"
        android:fadingEdge="vertical"
        android:layout_marginTop="0dp"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.futo.music.ui.views.topbars.GeneralTopBarView
                android:id="@+id/topbar"
                app:GeneralTopBar_text="Alpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:layout_marginTop="50dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">


                <com.futo.music.ui.views.general.SearchBarView
                    android:id="@+id/view_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    android:paddingBottom="0dp"
                    app:SearchBarView_hint="@string/hint_search_home"
                    app:SearchBarView_background="@drawable/background_bar_transparant_round_15dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <LinearLayout
                    android:id="@+id/container_shuffles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="7dp"
                    android:layout_marginRight="7dp">
                    <com.futo.music.ui.buttons.StandardButton
                        android:id="@+id/button_shuffle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:StandardButton_Color="#99222222"
                        app:StandardButton_Icon="@drawable/media3_icon_shuffle_on"
                        app:StandardButton_Background="@drawable/background_bar_transparant_round_15dp"
                        app:StandardButton_Text="Shuffle"
                        android:layout_weight="1" />
                    <com.futo.music.ui.buttons.StandardButton
                        android:id="@+id/button_wshuffle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-5dp"
                        app:StandardButton_Color="#99222222"
                        app:StandardButton_Background="@drawable/background_bar_transparant_round_15dp"
                        app:StandardButton_Icon="@drawable/ic_imagine"
                        app:StandardButton_Text="Smart Shuffle"
                        android:layout_weight="1.3" />

                    <com.futo.music.ui.buttons.StandardButton
                        android:id="@+id/button_help"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        app:StandardButton_Color="#99222222"
                        android:layout_marginLeft="-5dp"
                        app:StandardButton_Background="@drawable/background_bar_transparant_round_15dp"
                        app:StandardButton_Text="\?" />
                </LinearLayout>


                <com.futo.music.ui.views.containers.ContentGrid
                    android:id="@+id/grid_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ContentGrid_text="Recent Plays"
                    app:ContentGrid_row_height="150dp"
                    android:layout_marginTop="20dp"
                    app:ContentGrid_vertical="false" />

                <com.futo.music.ui.views.containers.ContentGrid
                    android:id="@+id/grid_playlists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ContentGrid_row_height="150dp"
                    app:ContentGrid_text="Your Playlists"
                    android:layout_marginTop="15dp"
                    app:ContentGrid_vertical="false" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/container_playlist_create"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/text_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        android:textSize="22dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="#EEEEEE"
                        android:text="Your Playlists"
                        android:layout_marginLeft="15dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginTop="20dp"
                        android:paddingBottom="5dp" />

                    <com.futo.music.ui.buttons.RoundButton
                        android:id="@+id/button_add_playlist"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="10dp"
                        app:RoundButton_image="@drawable/media3_icon_plus"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        app:layout_constraintTop_toBottomOf="@id/text_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="textStart"
                        android:layout_marginLeft="15dp"
                        android:text="@string/no_playlists_text" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <com.futo.music.ui.views.containers.ContentGrid
                    android:id="@+id/grid_artists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ContentGrid_row_height="130dp"
                    app:ContentGrid_text="Artists"
                    android:layout_marginTop="20dp"
                    app:ContentGrid_vertical="false" />
                <com.futo.music.ui.views.containers.ContentGrid
                    android:id="@+id/grid_albums"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ContentGrid_row_height="170dp"
                    app:ContentGrid_text="Albums"
                    android:layout_marginTop="20dp"
                    app:ContentGrid_vertical="false" />
                <com.futo.music.ui.views.containers.ContentGrid
                    android:id="@+id/grid_songs_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ContentGrid_row_height="170dp"
                    app:ContentGrid_text="New Songs"
                    android:layout_marginTop="20dp"
                    app:ContentGrid_vertical="false" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>