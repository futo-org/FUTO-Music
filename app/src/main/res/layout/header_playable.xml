<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_header"
        android:layout_width="120dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintDimensionRatio="1"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:src="#111111"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/roundedCorners_8dp"
        />

    <com.futo.music.ui.views.images.QuadImageView
        android:id="@+id/image_header_quad"
        android:layout_width="120dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintDimensionRatio="1"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:src="#111111"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearance="@style/roundedCorners_8dp"
        />

    <TextView
        android:id="@+id/text_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/image_header"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="2dp"
        android:textAlignment="center"
        android:maxLines="1" />

    <TextView
        android:id="@+id/text_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/text_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:textColor="#595959"
        android:textSize="12dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="12dp"
        android:textAlignment="center"
        android:maxLines="1" />




    <com.futo.music.ui.buttons.RatingsButton
        android:id="@+id/buttons_rating"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/text_metadata"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="80dp"
        android:layout_marginRight="80dp" />

    <ImageButton
        android:id="@+id/button_play_all"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/buttons_rating"
        app:layout_constraintBottom_toBottomOf="@id/buttons_rating"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/buttons_rating"
        android:background="@drawable/background_bar_transparant_71_round_4dp"
        android:layout_marginTop="-2dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play" />
    <ImageButton
        android:id="@+id/button_shuffle"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/buttons_rating"
        app:layout_constraintBottom_toBottomOf="@id/buttons_rating"
        app:layout_constraintLeft_toRightOf="@id/buttons_rating"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@drawable/background_bar_transparant_71_round_4dp"
        android:layout_marginTop="-2dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shuffle_white" />

    <LinearLayout
        android:id="@+id/container_additions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/buttons_rating">

    </LinearLayout>

    <com.futo.music.ui.views.general.SearchBarView
        android:id="@+id/view_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="5dp"
        android:layout_marginTop="7dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="40dp"
        app:SearchBarView_hint="@string/hint_filter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/button_switch"
        app:layout_constraintTop_toBottomOf="@id/container_additions" />

    <ImageButton
        android:id="@+id/button_switch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="@id/view_search"
        app:layout_constraintTop_toBottomOf="@id/view_search"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginRight="15dp"
        android:background="@drawable/background_button_accent_round_5dp"
        android:src="@drawable/ic_music_note"
        />
</androidx.constraintlayout.widget.ConstraintLayout>