<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_bar_transparant_71_round_4dp"
    android:id="@+id/root"
    android:layout_margin="5dp">
    <com.futo.music.ui.views.general.EditText
        android:id="@+id/text_search"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:maxLines="1"
        android:textSize="15dp"
        android:lineHeight="20dp"
        android:autoSizeTextType="uniform"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:fontFamily="@font/inter_regular"
        android:textColorHint="#444444"
        android:background="@drawable/background_bar_transparant_71_round_4dp"
        android:backgroundTint="@null"
        android:foreground="@color/transparent"
        android:paddingLeft="10dp"
        android:layout_margin="0dp"
        />

    <ImageButton
        android:id="@+id/button_clear"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="@id/text_search"
        app:layout_constraintBottom_toBottomOf="@id/text_search"
        app:layout_constraintRight_toRightOf="parent"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_clear"
        android:alpha="0.3"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="1"
        android:background="@color/transparent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>