<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="#00000000">



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdgeLength="30dp"
        android:fadingEdge="vertical"
        android:requiresFadingEdge="vertical" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_top"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:src="@drawable/ic_chev_left"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/button_options"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:src="@drawable/ic_gear"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:scaleType="fitCenter" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/container_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <!--
        <com.futo.music.ui.buttons.StandardButton
            android:id="@+id/button_play_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:StandardButton_Text="Play All"
            app:StandardButton_Icon="@drawable/ic_play"
            app:StandardButton_color="#AA000000" />
        <com.futo.music.ui.buttons.StandardButton
            android:id="@+id/button_shuffle_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:StandardButton_Text="Shuffle All"
            app:StandardButton_Icon="@drawable/ic_shuffle"
            app:StandardButton_color="#AA000000" />
        -->
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>