<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="5dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/player_peek"
        android:elevation="10dp"
        android:background="@drawable/background_bar_transparant_round_15dp">

        <ImageView
            android:id="@+id/progress_image"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="5dp"
            android:alpha="0.8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/text_progress_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:textSize="12dp"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toRightOf="@id/progress_image"
            app:layout_constraintRight_toRightOf="parent" />
        <TextView
            android:id="@+id/text_progress_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_light"
            android:textSize="10dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/text_progress_title"
            app:layout_constraintLeft_toRightOf="@id/progress_image"
            app:layout_constraintRight_toRightOf="parent" />

        <ProgressBar
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:id="@+id/progress_ann"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:indeterminate="true"
            android:progressTint="#44FFFFFF"
            android:progressBackgroundTint="#0AFFFFFF"
            app:layout_constraintTop_toBottomOf="@id/progress_image"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.futo.music.ui.views.playback.PlaybackPeekView
        android:id="@+id/player_peek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar_buttons" />

    <LinearLayout
        android:id="@+id/bottom_bar_buttons"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/background_bar_transparant_round_15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.futo.music.ui.buttons.MenuBottomButton
            android:id="@+id/button_home"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:BottomMenuButton_image="@drawable/ic_home"
            app:BottomMenuButton_imageActive="@drawable/ic_home_active"
            app:BottomMenuButton_text="Home"
            android:layout_weight="1" />

        <!--
        <com.futo.music.ui.buttons.MenuBottomButton
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:BottomMenuButton_image="@drawable/ic_playlist"
            app:BottomMenuButton_text="Home"
            android:layout_weight="1" /> -->

        <com.futo.music.ui.buttons.MenuBottomButton
            android:id="@+id/button_search"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:BottomMenuButton_image="@drawable/ic_search"
            app:BottomMenuButton_imageActive="@drawable/ic_search"
            app:BottomMenuButton_text="Search"
            android:layout_weight="1" />

        <com.futo.music.ui.buttons.MenuBottomButton
            android:id="@+id/button_files"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:BottomMenuButton_image="@drawable/ic_files"
            app:BottomMenuButton_imageActive="@drawable/ic_files_active"
            app:BottomMenuButton_text="Files"
            android:layout_weight="1" />

        <!--
        <com.futo.music.ui.buttons.MenuBottomButton
            android:id="@+id/button_settings"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:BottomMenuButton_image="@drawable/ic_gear"
            app:BottomMenuButton_imageActive="@drawable/ic_gear_active"
            app:BottomMenuButton_text="Settings"
            android:layout_weight="1" />-->

    </LinearLayout>


    <com.futo.music.ui.views.progress.ProgressBar
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="1dp" />
</androidx.constraintlayout.widget.ConstraintLayout>