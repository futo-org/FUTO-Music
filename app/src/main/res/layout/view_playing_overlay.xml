<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="#EE000000">

    <ImageButton
        android:id="@+id/button_close"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:src="@drawable/ic_close"
        />

    <TextView
        android:id="@+id/text_title_label"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textAlignment="center"
        android:text="Now Playing"
        android:textSize="16dp"
        android:textColor="#AAAAAA"
        android:fontFamily="@font/inter_bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="10dp"
        android:layout_marginTop="70dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:layout_marginRight="55dp"
                android:layout_marginLeft="55dp"
                android:text="Some Playlist"
                app:layout_constraintTop_toBottomOf="@id/text_title_label"
                android:textSize="20dp"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_light"
                />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_bar_transparant_round_15dp"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/text_artist_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#AAFFFFFF"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:fontFamily="@font/inter_regular"
                    android:textAlignment="center"
                    android:layout_margin="20dp"
                    android:textSize="16dp"
                    android:text="Artist" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_artist"
                    android:layout_height="90dp"
                    android:layout_width="90dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="10dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/roundedCorners_45dp"
                    app:srcCompat="@drawable/ic_artist_thumbnail"
                    app:layout_constraintTop_toBottomOf="@id/text_artist_header"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />

                <TextView
                    android:id="@+id/text_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="20dp"
                    app:layout_constraintTop_toBottomOf="@id/image_artist" />
                <com.futo.music.ui.buttons.RatingsButton
                    android:id="@+id/rating_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/text_artist"
                    android:layout_margin="20dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_bar_transparant_round_15dp"
                android:layout_margin="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/text_album_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#AAFFFFFF"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:fontFamily="@font/inter_regular"
                    android:textAlignment="center"
                    android:layout_margin="20dp"
                    android:textSize="16dp"
                    android:text="Album" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_album"
                    android:layout_height="90dp"
                    android:layout_width="90dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="10dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/roundedCorners_4dp"
                    app:srcCompat="@drawable/unknown_music"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_album_header"
                    app:layout_constraintRight_toRightOf="parent" />
                <TextView
                    android:id="@+id/text_album"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_marginTop="10dp"
                    android:textSize="20dp"
                    app:layout_constraintTop_toBottomOf="@id/image_album" />
                <com.futo.music.ui.buttons.RatingsButton
                    android:id="@+id/rating_album"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/text_album"
                    android:layout_margin="20dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_playlists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/background_bar_transparant_round_15dp"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/text_included_in"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="#EEFFFFFF"
                    android:layout_margin="20dp"
                    android:textSize="20dp"
                    android:text="Included In" />
                <TextView
                    android:id="@+id/text_playlists"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@id/text_included_in"
                    app:layout_constraintBottom_toBottomOf="@id/text_included_in"
                    android:fontFamily="@font/inter_regular"
                    android:layout_marginRight="20dp"
                    android:textSize="14dp"
                    android:textColor="#888"
                    android:textAllCaps="true"
                    android:text="x Playlists" />

                <LinearLayout
                    android:id="@+id/list_playlists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="15dp"
                    android:paddingBottom="20dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    app:layout_constraintTop_toBottomOf="@id/text_included_in" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>