<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/view_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BB000000" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlay_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/background_round_top_35dp">
        <TextView
            android:id="@+id/text_title"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:textAlignment="center"
            app:layout_constraintBottom_toTopOf="@id/buttons_primary"
            android:textSize="12dp"
            android:textColor="#AAAAAA"
            android:fontFamily="@font/inter_bold"
            />

        <LinearLayout
            android:id="@+id/buttons_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/buttons_secondary"
            android:paddingBottom="10dp"
            android:paddingTop="10dp"
            android:gravity="center">

            <com.futo.music.ui.buttons.IconButton
                android:id="@+id/button_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:IconButton_background="@drawable/background_round_playable_primary_35dp"
                app:IconButton_image="@drawable/ic_play"
                app:IconButton_text="Play" />
            <com.futo.music.ui.buttons.IconButton
                android:id="@+id/button_play_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:IconButton_background="@drawable/background_round_playable_primary_35dp"
                app:IconButton_image="@drawable/media3_icon_queue_next"
                app:IconButton_text="Play Next" />
            <com.futo.music.ui.buttons.IconButton
                android:id="@+id/button_queue_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:IconButton_background="@drawable/background_round_playable_primary_35dp"
                app:IconButton_image="@drawable/media3_icon_queue_add"
                app:IconButton_text="Queue Add" />
            <com.futo.music.ui.buttons.IconButton
                android:id="@+id/button_add_playlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:IconButton_background="@drawable/background_round_playable_primary_35dp"
                app:IconButton_image="@drawable/ic_playlist_add"
                app:IconButton_text="Add to Playlist" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/buttons_secondary"
            android:background="#111111"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">



        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>