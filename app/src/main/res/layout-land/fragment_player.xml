    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:src="@drawable/ic_chev_left"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="fitCenter" />
    <ImageButton
        android:id="@+id/button_options"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:src="@drawable/ic_dots"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="fitCenter" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/half_height_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.3" />

            <androidx.media3.ui.PlayerControlView
                android:id="@+id/view_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                app:show_timeout="-1"
                android:layout_marginBottom="80dp"
                app:layout_constraintTop_toBottomOf="@id/half_height_guideline"
                app:controller_layout_id="@layout/video_player_ui" />

            <LinearLayout
                android:id="@+id/container_trait_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="20dp"
                app:layout_constraintTop_toBottomOf="@id/view_control"
                app:layout_constraintLeft_toLeftOf="parent">

                <ImageButton
                    android:id="@+id/button_shuffle"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_shuffle"
                    android:background="@color/transparent"
                    android:scaleType="fitCenter"
                    android:padding="5dp"
                    />

            </LinearLayout>
            <com.futo.music.ui.buttons.RatingsButton
                android:id="@+id/buttons_rating"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                app:RatingsButton_swipe="true"
                app:layout_constraintLeft_toRightOf="@id/container_trait_left"
                app:layout_constraintRight_toLeftOf="@id/container_trait_right"
                app:layout_constraintTop_toTopOf="@id/container_trait_left"
                app:layout_constraintBottom_toBottomOf="@id/container_trait_right"/>
            <TextView
                android:id="@+id/text_rating_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttons_rating"
                android:visibility="invisible"
                android:textAlignment="center"
                android:textSize="10dp"
                android:textColor="#AAFFFFFF" />

            <LinearLayout
                android:id="@+id/container_trait_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginRight="20dp"
                app:layout_constraintTop_toTopOf="@id/container_trait_left"
                app:layout_constraintRight_toRightOf="parent">
                <ImageButton
                    android:id="@+id/button_loop"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_repeat"
                    android:background="@color/transparent"
                    android:scaleType="fitCenter"
                    android:padding="5dp"
                    />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/container_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/buttons_rating"
                app:layout_constraintLeft_toLeftOf="@id/view_control"
                app:layout_constraintRight_toRightOf="@id/view_control"
                android:layout_marginTop="15dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:scrollHorizontally="true"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:text="Track Name"
                    android:layout_gravity="start"
                    android:textSize="23sp" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <ImageView
                        android:id="@+id/image_artist"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="1"
                        app:layout_constraintTop_toTopOf="@id/text_artist"
                        app:layout_constraintBottom_toBottomOf="@id/text_artist"
                        app:layout_constraintLeft_toLeftOf="parent"
                        android:alpha="0.5"
                        android:src="@drawable/ic_artist" />
                    <TextView
                        android:id="@+id/text_artist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_light"
                        android:gravity="start"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:textColor="#FFFFFF"
                        android:alpha="0.5"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="Artist"
                        app:layout_constraintLeft_toRightOf="@id/image_artist"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintRight_toLeftOf="@id/star_artist"
                        android:textSize="17sp" />
                    <com.futo.music.ui.views.StarButton
                        android:id="@+id/star_artist"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toTopOf="@id/text_artist"
                        app:layout_constraintBottom_toBottomOf="@id/text_artist"
                        app:layout_constraintRight_toRightOf="parent"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_marginTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/image_album"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="1"
                        app:layout_constraintTop_toTopOf="@id/text_album"
                        app:layout_constraintBottom_toBottomOf="@id/text_album"
                        app:layout_constraintLeft_toLeftOf="parent"
                        android:alpha="0.5"
                        android:src="@drawable/media3_icon_album" />
                    <TextView
                        android:id="@+id/text_album"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_light"
                        android:gravity="start"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:textColor="#FFFFFF"
                        android:alpha="0.5"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="Album"
                        app:layout_constraintLeft_toRightOf="@id/image_album"
                        app:layout_constraintRight_toLeftOf="@id/star_album"
                        app:layout_constraintTop_toTopOf="parent"
                        android:textSize="17sp" />
                    <com.futo.music.ui.views.StarButton
                        android:id="@+id/star_album"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toTopOf="@id/text_album"
                        app:layout_constraintBottom_toBottomOf="@id/text_album"
                        app:layout_constraintRight_toRightOf="parent"  />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/container_title"
                app:layout_constraintBottom_toTopOf="@id/container_bottom"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="0dp"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/button_left"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_skip_previous"
                    android:background="@color/transparent"
                    android:scaleType="fitCenter"
                    android:padding="10dp"
                    android:layout_margin="10dp"
                    />
                <ImageButton
                    android:id="@+id/button_play"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/background_round_play_button"
                    android:layout_margin="10dp"
                    android:scaleType="fitCenter"
                    android:padding="20dp"
                    />
                <ImageButton
                    android:id="@+id/button_right"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_skip_next"
                    android:background="@color/transparent"
                    android:scaleType="fitCenter"
                    android:padding="10dp"
                    android:layout_margin="10dp"
                    />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:paddingTop="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/button_meta"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_info"
                            android:background="@color/transparent"
                            android:scaleType="fitCenter"
                            android:padding="10dp"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/container_queue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:layout_marginBottom="5dp"
                        android:orientation="vertical"
                        android:background="@drawable/background_glass_dark_round_8dp"
                        android:paddingBottom="10dp"
                        android:paddingTop="10dp"
                        android:alpha="0"
                        android:gravity="center">
                        <!--
                        <ImageButton
                            android:id="@+id/button_queue"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_list"
                            android:background="@color/transparent"
                            android:scaleType="fitCenter"
                            android:padding="10dp"
                            />
                        -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:textSize="12dp"
                            android:textColor="#999"
                            android:fontFamily="@font/inter_regular"
                            android:text="Queue" />
                        <TextView
                            android:id="@+id/text_queue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textSize="16dp"
                            android:text="Ministery of Sound"
                            android:textColor="@color/white"
                            android:fontFamily="@font/inter_regular"
                            android:layout_marginTop="-3dp"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:ellipsize="end"
                            android:textAlignment="center" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center">
                        <ImageButton
                            android:id="@+id/button_add_playlist"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_playlist_add"
                            android:background="@color/transparent"
                            android:scaleType="fitCenter"
                            android:padding="10dp"
                            />
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.futo.music.ui.views.playback.QueueOverlay
                android:id="@+id/overlay_queue"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>